# Buendia control-plane Supabase project (see decisions/0001-control-plane-supabase.md).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Control-plane secret key (Supabase service-role replacement). Server only —
# never read by browser code. Used by the edge serve route and JWT mint
# endpoint to read owner_backends + the app-html bucket on behalf of
# collaborators who don't have publishable-key RLS access.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Envelope-encryption KEK for owner-backend credentials. Generate with:
#   openssl rand -base64 32
# See decisions/0002-credential-envelope-encryption.md.
BUENDIA_MASTER_KEY=replace-with-base64-encoded-32-bytes

# Supabase Management OAuth app credentials. Register the app from your
# organization's settings: Dashboard → org → Apps → Add application
# (https://supabase.com/dashboard/org/<your-org-slug>/apps). Set the
# redirect URI to https://<your-production-host>/api/auth/supabase/callback.
# See decisions/0003-supabase-management-oauth.md.
SUPABASE_OAUTH_CLIENT_ID=your-supabase-oauth-client-id
SUPABASE_OAUTH_CLIENT_SECRET=your-supabase-oauth-client-secret
